# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL. Local example:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guessup?schema=public"
# Neon example (note sslmode=require):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/guessup?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guessup?schema=public"

PORT=3000

# Authentication (used from step 2 onwards)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Cloudinary (used when image upload is added to the admin panel)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
