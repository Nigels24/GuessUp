{
  "cli": { "version": ">= 5.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://guessup-api-krgb.onrender.com/api",
        "EXPO_PUBLIC_SHOW_DEMO_LOGIN": "false"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://guessup-api-krgb.onrender.com/api",
        "EXPO_PUBLIC_SHOW_DEMO_LOGIN": "false"
      }
    }
  },
  "submit": { "production": {} }
}
