# Fallback API address used when no address has been saved in the app yet.
# The address can always be changed on the app's API address screen.
# The preview and production builds in eas.json set this same deployed address.
# For local development use your laptop instead, e.g.
#   EXPO_PUBLIC_API_URL=http://<laptop-IP>:3000/api   (real phone on the same Wi-Fi)
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api      (Android emulator)
EXPO_PUBLIC_API_URL=https://guessup-api-krgb.onrender.com/api

# Optional student "Demo account" box on the login screen, for local runs only.
# Off by default; eas.json turns it off in the preview and production builds.
# EXPO_PUBLIC_SHOW_DEMO_LOGIN=true
# EXPO_PUBLIC_DEMO_EMAIL=
# EXPO_PUBLIC_DEMO_PASSWORD=
