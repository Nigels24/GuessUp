{
  "expo": {
    "name": "GuessUp",
    "slug": "guessup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3A1BB8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ph.edu.jhcsc.guessup",
      "versionCode": 1,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "guessup",
    "primaryColor": "#6C4CF1",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "GuessUp uses your photos only when you choose a profile picture.",
          "cameraPermission": "GuessUp uses the camera only when you take a profile picture.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#6C4CF1",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#FFFFFF",
            "cropBackButtonIconColor": "#FFFFFF",
            "cropBackgroundColor": "#1E1847"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E1A8C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "629033ce-85fd-47a4-adad-e735bc2d16ca"
      }
    }
  }
}
